# Local development only. Copy to .env before starting Compose.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173

# Go commands read environment variables directly (not this file):
# DATABASE_URL=postgres://marketplace:local-development-only@localhost:5432/marketplace?sslmode=disable
# TEST_DATABASE_URL must point to a separate empty database ending in _test.
# TEST_PRODUCTS_DATABASE_URL is a separate empty *_test database for product API integration tests.

# Generate with: openssl rand -hex 32 (never commit the resulting secret).
JWT_SECRET=
# Local HTTP only. Set true for every HTTPS deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Exact comma-separated frontend origins, no trailing slash or wildcard.
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# TEST_AUTH_DATABASE_URL is a separate empty *_test database for auth integration tests.
# TEST_HOME_DATABASE_URL is a separate empty *_test database for homepage integration tests.

# TEST_COMMERCE_DATABASE_URL is a separate empty *_test database for transactional checkout tests.
